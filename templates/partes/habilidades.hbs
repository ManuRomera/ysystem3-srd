<div class="ys-grupos">
  {{#each atributos}}
  <article class="ys-grupo attr-{{clave}}">
    <header data-tooltip="{{ayuda}}">
      <span class="siglas"><b>{{label}}</b> <small>{{short}}</small></span>
      {{#unless sinBono}}{{#if @root.editando}}<input type="number" name="system.atributos.{{clave}}" value="{{base}}" step="1" aria-label="Bonificador de {{label}}">{{else}}<b class="bono">{{bonoTexto}}</b>{{/if}}{{/unless}}
    </header>
    <ul>
      {{#each habilidades}}
      <li class="{{#if bloqueada}}bloqueada{{/if}}">
        <button type="button" class="ys-hab" data-action="tirar" data-clave="{{clave}}" {{#if poder}}data-poder="1"{{/if}} data-tooltip="{{ayuda}}" {{#if bloqueada}}disabled{{/if}}>
          <span class="nom"><span class="n">{{etiqueta}}</span>{{#if oposicion}}<em class="opo" data-tooltip="Se tira contra {{oposicion}} del otro personaje">{{oposicionCorta}}</em>{{/if}}</span>
          <span class="pips">{{#each pips}}<i class="pip {{#if activo}}on{{/if}}{{#if extra}} extra{{/if}}" data-pip data-habilidad="{{../clave}}" data-valor="{{i}}"></i>{{/each}}</span>
          <span class="tot">{{total}}</span>
        </button>
      </li>
      {{/each}}
    </ul>
  </article>
  {{/each}}
</div>
