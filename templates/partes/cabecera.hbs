<header class="ys-cab">
  {{#if editable}}<button type="button" class="ys-retrato-btn" data-action="retrato" data-tooltip="Encuadre del retrato: elige la zona y el zoom"><img class="ys-retrato" src="{{actor.img}}" alt="" data-retrato="{{actor.id}}"><i class="fa-solid fa-crop-simple" inert></i></button>{{else}}<span class="ys-retrato-btn"><img class="ys-retrato" src="{{actor.img}}" alt="" data-retrato="{{actor.id}}"></span>{{/if}}
  <div class="ys-cab-main">
    <input class="ys-nombre" type="text" name="name" value="{{actor.name}}" placeholder="Nombre" {{#unless editable}}disabled{{/unless}}>
    <p class="ys-sub">{{{sub}}}</p>
  </div>
  <div class="ys-marca-caja" aria-hidden="true">
    {{#if marca.logo}}<img class="ys-marca-logo" src="{{marca.logo}}" alt="">{{else}}<span class="ys-marca"><b>{{marca.marca}}</b><i>{{marca.sub}}</i></span>{{/if}}
  </div>
  <div class="ys-cab-botones">
    {{#if editable}}<button type="button" class="ys-ico {{#if editando}}activo{{/if}}" data-action="editar" aria-pressed="{{#if editando}}true{{else}}false{{/if}}" data-tooltip="{{#if editando}}Bloquear la ficha{{else}}Desbloquear para editar atributos, dados y valores{{/if}}"><i class="fa-solid {{#if editando}}fa-lock-open{{else}}fa-lock{{/if}}"></i></button>{{/if}}
    <button type="button" class="ys-ico" data-action="compacto" data-tooltip="{{#if compacto}}Modo normal{{else}}Modo compacto{{/if}}"><i class="fa-solid {{#if compacto}}fa-expand{{else}}fa-compress{{/if}}"></i></button>
  </div>
</header>
